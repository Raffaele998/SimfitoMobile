$mode = ( isset($_REQUEST['mode']) ? $_REQUEST['mode'] : 'xls' );			// allowed : 'html', 'xls' , 'xlsasync' 
$start = (isset($_REQUEST['start']) ? $_REQUEST['start'] : '2019-01-01' );	// data iniziale
$end = (isset($_REQUEST['end']) ? $_REQUEST['end'] : '2019-06-30' );		// data finale
$debug = ( isset($_REQUEST['debug']) ? true : false );						// debug mode
$debugnoxls = ( isset($_REQUEST['noxls']) ? true : false );					// in debug mode don't emit xls

$year = substr($start,0,4);

$do_first = true;		// first block of report macro pest ( e.g. Aromia bungii )
$do_second = true;		// second block of report simple pest ( eg . ARUOMBU + buffers )

