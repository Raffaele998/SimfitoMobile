if (false) {
	// ad anno esatto
	// areas_query basata su l'anno E il pest nei viewparams
	$areas_qry = "select params->>'viewparams' as vp from simfito.areas where enabled and anno={YEAR} and params->>'viewparams' ilike '%pestcode:{PEST}%'order by id desc limit 1";
	// areas_query basata sulle date E il pest in colonna
	$areas_qryx = "select * from simfito.areas where enabled and pest='{PEST}' and anno={YEAR} ORDER by datefrom";
}
else {
	// ad anno>=
	// areas_query basata su l'anno E il pest in colonna O nei viewparams
	$areas_qry = "select params->>'viewparams' as vp from simfito.areas where enabled and anno<={YEAR} and ( not anno>{YEAR}) and (pest='{PEST}' or params->>'viewparams' ilike '%pestcode:{PEST}%')order by id desc limit 1";
	// areas_query basata sulle date E il pest in colonna
	$areas_qryx = "select * from simfito.areas where enabled and pest='{PEST}' and anno={YEAR} ORDER by datefrom";
}

