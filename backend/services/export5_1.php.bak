						$resxx[] = $ress[$i];
					}
					if ($debug) {
						echo "<b>DATASTART II STEP</b><br>"; 
					}
					datastart($ipest,'');
					dataheader($cols);
					foreach($resxx as $row) {
						datarow($row,$fields);
					}
					datadone();
				}
			}
		}
	}

	if(!$debug) {
		$cc = count($xlsfiles);
		if (exec_from_cli()) {
			echo "POSTPROCESS $cc FILES\n";
			foreach($xlsfiles as $i=>$f) {
				echo "PP $i -> $f\n";
			}
		}
		postprocess($zipout);
		$sql = "UPDATE simfito.reports SET statoreport_id=2,runend=now() WHERE id=$jobid";
		$db->SQL($sql);

	}
	else {
		$cc = count($xlsfiles);
		echo "<b>POSTPROCESS $cc FILES</b><br>";
		foreach($xlsfiles as $i=>$f) {
			echo "PP $i -> $ff<br>";
		}
	}
}

@fwrite($f,"____ END ____\n");
@fclose($f);
@chmod('log/exp.log',0777);


