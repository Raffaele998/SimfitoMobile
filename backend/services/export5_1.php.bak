			$ppests = substr($ppests,0,-1);

			// dati principali
			$sql = str_replace(['%start%','%end%','%pest%'],[$start,$end,$ppests],$mastersql);
			// dati per le trappole
			$sqltr = str_replace(['%start%','%end%','%pest%','%year%'],[$start,$end,$ppests,$year],$trappolesql);

			if ($mode!='xls')
				echo "<b>PEST $ipest <br>SQL MASTER:</b><br><pre>$sql</pre><br><b>SQL TRAPPOLE:</b><br><pre>$sqltr</pre><br>";

			$n = 0;
			$ress = array();
			// la parte principale
