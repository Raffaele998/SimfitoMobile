				echo "<b>SQL_A_{$pestnum}_{$ipest}_($ppests)</b><br>";
				echo "SQL $sql<br>";
				echo "SQLTR $sqltr<br>";
			}
			@fwrite($f,"------SQL-------\n");
			@fwrite($f,$sql . "\n");
			@fwrite($f,"------SQL_TR-------\n");
			@fwrite($f,$sqltr . "\n");
			$db->Read($sql);
			if ($debug) {
				echo "<b>RECNO</b> " . $db->RecNo() . "<br>";  
			}
			if (exec_from_cli()) {
				echo "FIRST SQL RECNO ($ppests) " . $db->RecNo() . "\n";  
			}
			$r_prev = array();
			while($r = $db->fetch_assoc()) {
				//var_dump($r);echo "<br>";
				$extr = find_duration($restd,$r['idtecnico'],$r['data_sopralluogo']);
				if (false && $mode!='xls') {
					var_dump($extr);echo "<br>";
				}
				$r['nhours'] = round($extr['duration']/60.0,2);
//				if ($r['campionicodice']!='') {
//					$r['sampleduration'] = 0.1;
//					$r['testno'] = 1;
//					$r['nhours'] -= 0.1; 
