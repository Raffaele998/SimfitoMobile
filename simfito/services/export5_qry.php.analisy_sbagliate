$mastersql = "WITH scheda_dati AS (
	WITH host AS ( 
		SELECT b_code,full_name FROM eppo.t_baycode 
		INNER JOIN eppo.t_bayname ON t_baycode.codeid=t_bayname.codeid
		WHERE isolang='la' AND preferred=1
	),
	analisys_campioni AS (
		SELECT 
			campioni_id,
			method_id,
			analisys.agent_id,
			string_agg(analisys.id::TEXT,',') AS analisys_id,
			array_agg(analisys.id) as analisys_id_arr,
			string_agg(analisys.pest,',') AS analisys_pest,
			case when string_agg(analisys.id::TEXT,',') is  null then 0 else array_length(array_agg(analisys.id),1) end AS analisys_no,
			string_agg(analisysresult.positive::TEXT,',') AS ar,
			case when sum(case analisysresult.positive when 1 then 1 else 0 end)>0 then 1 else 0 end AS ar1,
			sum(case analisysresult.positive when 1 then 1 else 0 end) as ar1x
		FROM simfitolab.analisys
		LEFT JOIN simfitolab.analisysresult ON analisysresult.id=analisys.analisysresult_id
		LEFT JOIN simfitolab.agent ON agent.id=analisys.agent_id
		LEFT JOIN simfitolab.method ON method.id=agent.method_id
		WHERE analisys.pest is null or analisys.pest in (%pest%) AND analisys.analisysstate_id<>3
		GROUP by campioni_id,method_id,analisys.agent_id
	),
	trappole_osservazioni AS ( 
		SELECT 
			osservazioni.idosservazioni,
			--ERA:string_agg(trappole.id::TEXT,',') AS trap,
			--ERA: array_agg(trappole.id) AS xtrap,
			--ERA: case when string_agg(trappole.id::TEXT,',') is  null then 0 else array_length(array_agg(trappole.id),1) end AS trap_no,
			string_agg(trappole_geometry::TEXT,',') AS trap,
			array_agg(trappole_geometry.id) AS xtrap,
			0 as trap_no,
			trappole_geometry.tipo_trappole_id,
			string_agg(trappole_geometry.codice,',') AS trap_codice,
			string_agg(distinct tipo_trappole.descrizione,',') AS tipo_trappole_descr,
			string_agg(distinct tipo_trappole.description,',') AS tipo_trappole_descr_en
		FROM simfito.osservazioni
		--ERA: LEFT JOIN simfito.trappole ON trappole.id_osservazione=osservazioni.idosservazioni
		--ERA: LEFT JOIN simfito.trappole_geometry ON trappole_geometry.id=trappole.trappole_geometry_id
        LEFT JOIN simfito.trappole_geometry ON trappole_geometry.id=osservazioni.trappole_geometry_id
		LEFT JOIN simfito.tipo_trappole ON tipo_trappole.id=trappole_geometry.tipo_trappole_id
		GROUP BY osservazioni.idosservazioni,trappole_geometry.tipo_trappole_id
	)	
	SELECT 
		scheda.idscheda, scheda.data_sopralluogo,scheda.protocollo,scheda.stato AS scheda_stato,scheda.gid_sito,scheda.idtipo_visita, 
		string_agg(osservazioni.idosservazioni::TEXT,',') AS oss,
		osservazioni.visiva as ossvis,
		string_agg(distinct host.full_name,',') AS hosts,
		sum(osservazioni.piante_camp_vis) AS n_osservate_tot,
		sum(osservazioni.n_osservate) AS n_osservate_tot1,
		sum(osservazioni.sup_vis)/10000 AS oss_sup_vis_ha,
		string_agg(osservazioni.sospetti,' - ') as oss_note,
		1 AS n_monitoraggio,
		round(coalesce(sum(osservazioni.tempo),30)/60.0,4) AS tempo_tot, 
		round(coalesce(sum(osservazioni.tempo),30)/60.0,4)*10.0 AS costo_tot,	
		string_agg(distinct COALESCE(tipocampione.description_en,tipocampione.description),',') AS tipocampione,	
		trappole_osservazioni.trap,
		trappole_osservazioni.xtrap,
		trappole_osservazioni.tipo_trappole_id,
		trappole_osservazioni.trap_codice,
		trappole_osservazioni.tipo_trappole_descr,
		trappole_osservazioni.tipo_trappole_descr_en,
		trappole_osservazioni.trap_no,
		count(*) AS cc,
		sum(campioni.elementicampione) AS campioni_no,
		case when sum(campioni.elementicampione) is null then 0 else 0.15 end AS sample_duration,
		0.15 AS sample_duration1,
		string_agg(distinct campioni.codice,',') AS campionicodice,
		string_agg(campioni.elementicampione::text,',') AS campioni_no_aggr,
		analisys_campioni.method_id,
		analisys_campioni.agent_id,
		--analisys_campioni.analisys_id,
		analisys_campioni.analisys_pest,
		sum(analisys_campioni.analisys_no) as analisys_no,
		sum(analisys_campioni.ar1x) as analisys_pos_no,
		avg(analisys_campioni.analisys_no)::int as analisys_no_avg,
		avg(analisys_campioni.ar1x)::int as analisys_pos_no_avg,
		array_length(array_distinct(('{' || string_agg(array_to_string(nullif(analisys_campioni.analisys_id_arr,'{}'),','),',') || '}')::integer[]),1) as analisys_no_len,
		--analisys_campioni.ar,
		--analisys_campioni.ar1,	
		case when sum(case osservazioni.rilevato when 1 then 1 else 0 end)>0 then 'Positivo' else 'Negativo' end AS ar3,
		case 
			when sum(analisys_no) is null or sum(analisys_no)=0 then 
				case when sum(case osservazioni.rilevato when 1 then 1 else 0 end)>0 then 'Positivo' else 'Negativo' end
			else 
				case when max(ar1)>0 then 'Positivo' else 'Negativo' end
		end AS ar5,
		coalesce(nullif(regexp_replace(
			string_agg(case 
				when report.id is null then ''
				else 'http://$hostapp/simfitolab/services/report.php?mode=pdf&table=report&idv=' || report.id::TEXT end
				,',')
		,'^,+$',''),''),'NON DISPONBILE') AS report_link
	FROM simfito.scheda
	INNER JOIN simfito.osservazioni ON osservazioni.idscheda=scheda.idscheda  
	INNER JOIN host ON host.b_code=osservazioni.hostcode                     
	LEFT JOIN simfito.campioni ON campioni.id=osservazioni.campioni_id
	LEFT JOIN simfito.tipocampione ON tipocampione.id=campioni.tipocampione_id 
	LEFT JOIN trappole_osservazioni ON trappole_osservazioni.idosservazioni=osservazioni.idosservazioni 
	LEFT JOIN analisys_campioni on analisys_campioni.campioni_id=campioni.id
	LEFT JOIN simfitolab.report ON report.campioni_id=campioni.id
	WHERE 
		scheda.stato=2 AND 
		(osservazioni.campioni_id is null OR campioni.laboratoriostato_id>3 ) AND
		data_sopralluogo>='%start%' AND data_sopralluogo<='%end%' AND
		(pestcode in (%pest%) OR osservazioni.idosservazioni IN ( select idosservazioni from simfito.osservazioni inner join simfitolab.analisys on osservazioni.campioni_id=analisys.campioni_id where pest in (%pest%) ) )
	GROUP BY 
		scheda.idscheda, 
		scheda.data_sopralluogo,
		scheda.protocollo,
		scheda.gid_sito,
		scheda.idtipo_visita,
		osservazioni.visiva,
		trappole_osservazioni.trap,
		trappole_osservazioni.xtrap,
		trappole_osservazioni.tipo_trappole_id,
		trappole_osservazioni.trap_codice,
		trappole_osservazioni.tipo_trappole_descr,
		trappole_osservazioni.tipo_trappole_descr_en,
		trappole_osservazioni.trap_no,
		--analisys_campioni.campioni_id,
		--analisys_campioni.analisys_id,
		analisys_campioni.analisys_pest,
		--analisys_campioni.analisys_no,
		--analisys_campioni.ar,
		--analisys_campioni.ar1,
		analisys_campioni.method_id,
		analisys_campioni.agent_id
	),
	tecnici_scheda AS (
		WITH y0 AS (
			SELECT idscheda,id_tecnico FROM simfito.scheda
			UNION
			SELECT idscheda,id_tecnico FROM simfito.schede_tecnici
		)
		SELECT 
			idscheda,string_agg(distinct cognome || ' ' || nome,',') AS tecnici_nome,
--			avg(costo_orario) AS costo_orario_avg,sum(costo_orario) AS costo_orario_tot,
			avg(costiorari.costo_orario) AS costo_orario_avg,sum(costiorari.costo_orario) AS costo_orario_tot,
			count(*) AS tecnici_no 
		FROM y0 
		INNER JOIN simfito.tecnici ON tecnici.id_tecnico=y0.id_tecnico  
		LEFT JOIN simfito.costiorari ON costiorari.id_tecnico=tecnici.id_tecnico 
		GROUP BY idscheda
	)
SELECT 
	COALESCE(method.name_en,method.name) as method_name,
	agent.name as agent_name,
	method.id, 
	tecnici_scheda.tecnici_nome,
	tecnici_scheda.tecnici_no,
	tecnici_scheda.costo_orario_avg,
	scheda_dati.*,
	round(scheda_dati.tempo_tot*tecnici_scheda.tecnici_no,2) AS full_tempo_tot,
	scheda_dati.tempo_tot*costo_orario_tot AS costo_tot,
	siti.tipologiasito_id,
	COALESCE(tipologiasito.description_en,tipologiasito.description) AS tipologiasito_description,
    tipo_visita.motivo as tipovisita_motivo,
	siti.superficie_ha/10000 AS s_ha,
	CASE WHEN oss_sup_vis_ha>siti.superficie_ha/10000 THEN siti.superficie_ha/10000 ELSE oss_sup_vis_ha END as oss_sup_vis_ha_x,
	$coord
	COALESCE(motivi2020.descrizione,tipo_visita.motivo_en,tipo_visita.motivo) AS scheda_motivo,
	comuni.nome as comuni_comune,
    comuni.provincia as comuni_provincia,
	case when campioni_no>analisys_no_len then analisys_no_len else campioni_no end as campioni_no_ex 
FROM scheda_dati
INNER JOIN tecnici_scheda ON tecnici_scheda.idscheda=scheda_dati.idscheda 
INNER JOIN simfito.siti ON siti.gid=scheda_dati.gid_sito
LEFT JOIN comuni ON siti.comune_istat=comuni.istat                  
LEFT JOIN simfito.tipologiasito ON tipologiasito.id=siti.tipologiasito_id 
LEFT JOIN simfito.tipo_visita ON tipo_visita.idtipo_visita=scheda_dati.idtipo_visita 
LEFT JOIN simfito.motivi2020 on motivi2020.tipologiasito_id=tipo_visita.idtipo_visita
LEFT JOIN simfitolab.method ON method.id=scheda_dati.method_id
LEFT JOIN simfitolab.agent on agent.id=scheda_dati.agent_id	
ORDER by data_sopralluogo,scheda_dati.idscheda,oss";

