	'' as n_monitoraggio,
	round(trappole_geometry.tempo/60.0,4) as trap_tempo_tot,
--	tecnici.costo_orario as trap_costo,
--	trappole_geometry.tempo*tecnici.costo_orario as trap_costo_tot,
	costiorari.costo_orario AS trap_costo,
    trappole_geometry.tempo*costiorari.costo_orario AS trap_costo_tot,
	'' as tipocampione,
	trappole_geometry.codice as trap,
	trappole_geometry.id as xtrap,
	tipo_trappole_id,
	trappole_geometry.codice as trap_codice,
	tipo_trappole.descrizione as tipo_trappole_descr,
	tipo_trappole.description as tipo_trappole_descr_en,
	1 as trap_no,
	0 as cc,
	'' as campioni_no,
	0 as sample_duration,
	0 as sample_duration1,
	'' as campionicodice,	'' as method_id,	'' as analisys_pest,	'' as analisys_no,
	'' as ar3,	'' as ar5,	'' as report_link,	'' as full_tempo_tot,	'' as costo_tot,
	siti.tipologiasito_id,
	COALESCE(motivi2020.descrizione,tipologiasito.description_en,tipologiasito.description) AS tipologiasito_description,
    '' as tipovisita_motivo,
	siti.superficie_ha/10000 AS s_ha,
	--$coord
	COALESCE(motivi2020.descrizione,tipo_visita.motivo_en,tipo_visita.motivo) AS scheda_motivo,
    tipo_visita.motivo as tipovisita_motivo
from simfito.trappole_geometry
--ERA: left join simfito.trappole on trappole.trappole_geometry_id=trappole_geometry.id
--ERA: left join simfito.osservazioni on osservazioni.idosservazioni=trappole.id_osservazione
--ERA: left join simfito.scheda on scheda.idscheda=osservazioni.idscheda
INNER Join simfito.scheda on scheda.idscheda=trappole_geometry.scheda_id
inner join simfito.tecnici on simfito.tecnici.id_tecnico=simfito.trappole_geometry.tecnico_id
LEFT JOIN simfito.costiorari ON costiorari.id_tecnico=tecnici.id_tecnico 
inner join simfito.siti on simfito.siti.gid=simfito.trappole_geometry.gid
LEFT JOIN simfito.tipologiasito ON tipologiasito.id=siti.tipologiasito_id 
LEFT JOIN simfito.motivi2020 on motivi2020.tipologiasito_id=siti.tipologiasito_id
inner join simfito.tipo_trappole on simfito.tipo_trappole.id=simfito.trappole_geometry.tipo_trappole_id 
LEFT JOIN simfito.tipo_visita ON tipo_visita.idtipo_visita=scheda.idtipo_visita 
where organismo in (%pest%) and ( (anno=%year% and data_sopralluogo is null) or (data_sopralluogo>='%start%' and data_sopralluogo<='%end%'))
  --and (trappole_geometry.statotrappole_id!=0 and date_trunc('day',datacreazione)=date_trunc('day',datavariazione))
  and ( (scheda.data_sopralluogo is null) or (scheda.stato=2 and date_trunc('day',datacreazione)=scheda.data_sopralluogo)  )
order by data_sopralluogo";

